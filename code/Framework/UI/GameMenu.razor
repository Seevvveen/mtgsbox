@using Sandbox
@using Sandbox.Network
@using Sandbox.UI
@using System
@using System.Threading
@using Sandbox.Classes.Deck
@using Sandbox.Classes.Deck.Import
@using Sandbox.Classes.Database
@using Sandbox.Framework
@using Sandbox.Framework.GameInfo
@using Sandbox.Framework.Table

@inherits PanelComponent
@namespace Sandbox.Framework.UI

<root class="@RootClass()">
	@if ( Match is null )
	{
		<div class="menu-shell">
			<div class="brand-panel">
				<div class="brand-mark">M</div>
				<div class="eyebrow">TABLETOP SANDBOX</div>
				<div class="game-title">Magic<br />Sandbox</div>
				<div class="game-subtitle">Build decks, find a table, and play.</div>
				<div class="database-status @(Database?.IsReady == true ? "ready" : string.Empty)">
					<div class="status-dot"></div>
					<div>@(Database?.StatusMessage ?? "Card database unavailable")</div>
				</div>
			</div>

			<div class="content-panel">
				@if ( CurrentPage == MenuPage.Main )
				{
					<div class="page-heading">
						<div class="page-title">Main Menu</div>
						<div class="page-copy">What would you like to do?</div>
					</div>

					<div class="main-actions">
						<button class="menu-action primary" onclick="@(() => OpenPage( MenuPage.StartMatch ))">
							<div class="action-icon">add_circle</div>
							<div class="action-copy"><div class="action-title">Start a Match</div><div class="action-detail">Create a new table and invite players</div></div>
						</button>

						<button class="menu-action" onclick="@QuickFindMatch">
							<div class="action-icon">travel_explore</div>
							<div class="action-copy"><div class="action-title">@(_isFinding ? "Finding a Match…" : "Find a Match")</div><div class="action-detail">Quickly join the first available table</div></div>
						</button>

						<button class="menu-action" onclick="@(() => OpenPage( MenuPage.MatchList ))">
							<div class="action-icon">list</div>
							<div class="action-copy"><div class="action-title">Match List</div><div class="action-detail">Browse all currently available tables</div></div>
						</button>

						<button class="menu-action" onclick="@(() => OpenPage( MenuPage.DeckEditor ))">
							<div class="action-icon">style</div>
							<div class="action-copy"><div class="action-title">Deck Editor</div><div class="action-detail">Import and inspect a deck list</div></div>
						</button>

						<button class="menu-action" onclick="@(() => OpenPage( MenuPage.Settings ))">
							<div class="action-icon">settings</div>
							<div class="action-copy"><div class="action-title">Game Settings</div><div class="action-detail">Change table and camera preferences</div></div>
						</button>

						<button class="menu-action danger" onclick="@ExitGame">
							<div class="action-icon">logout</div>
							<div class="action-copy"><div class="action-title">Exit Game</div><div class="action-detail">Return to your desktop</div></div>
						</button>
					</div>
				}
				else
				{
					<div class="subpage-header">
						<button class="back-button" onclick="@(() => OpenPage( MenuPage.Main ))">arrow_back</button>
						<div class="page-heading">
							<div class="page-title">@PageTitle</div>
							<div class="page-copy">@PageDescription</div>
						</div>
					</div>

					@if ( CurrentPage == MenuPage.StartMatch )
					{
						<div class="scroll-content">
							<div class="section-label">FORMAT</div>
							<div class="format-list">
								@foreach ( MTGFormat format in AvailableFormats )
								{
									<button class="format-option @(IsSelected( format ) ? "selected" : string.Empty)" onclick="@(() => SelectFormat( format ))">
										<div><div class="format-name">@format.DisplayName</div><div class="format-details">@FormatSummary( format )</div></div>
										<div class="selection-mark">@(IsSelected( format ) ? "check_circle" : "radio_button_unchecked")</div>
									</button>
								}
								@if ( AvailableFormats.Count == 0 )
								{
									<div class="empty-state">No MTG format assets were found.</div>
								}
							</div>

							<div class="section-label">TABLE</div>
							<TextEntry class="text-input" Value:bind="@LobbyName" Placeholder="Match name" />
							<button class="setting-row" onclick="@ToggleMultiplayer">
								<div><div class="setting-name">Table type</div><div class="setting-detail">@(Director?.IsMultiplayer == true ? "Public multiplayer lobby" : "Local practice match")</div></div>
								<div class="setting-value">@(Director?.IsMultiplayer == true ? "ONLINE" : "LOCAL")</div>
							</button>
						</div>

						<button class="wide-button primary @(CanStartMatch ? string.Empty : "disabled")" onclick="@StartLobby">Create Match</button>
					}
					else if ( CurrentPage == MenuPage.MatchList )
					{
						<div class="match-toolbar">
							<div class="match-count">@(_isRefreshing ? "Searching…" : $"{_lobbies.Count} available")</div>
							<button class="small-button" onclick="@RefreshMatches">refresh&nbsp;&nbsp;Refresh</button>
						</div>

						<div class="match-list">
							@foreach ( LobbyInformation lobby in _lobbies )
							{
								<div class="match-row">
									<div class="match-info"><div class="match-name">@lobby.Name</div><div class="match-detail">@LobbyDetail( lobby )</div></div>
									<button class="join-button @(CanJoin( lobby ) ? string.Empty : "disabled")" onclick="@(() => JoinLobby( lobby ))">@(lobby.IsFull ? "Full" : "Join")</button>
								</div>
							}
							@if ( !_isRefreshing && _lobbies.Count == 0 )
							{
								<div class="empty-state tall"><div class="empty-icon">search_off</div><div>No open matches found.</div><div class="muted">Try refreshing or start your own table.</div></div>
							}
						</div>
					}
					else if ( CurrentPage == MenuPage.DeckEditor )
					{
						<div class="deck-editor">
							<TextEntry class="deck-input" Value:bind="@EditorDeckText" Placeholder="Paste a deck list here…" Multiline="@true" />
							<div class="deck-editor-actions">
								<button class="small-button" onclick="@ClearEditor">Clear</button>
								<button class="small-button primary" onclick="@ImportEditorDeck">Import Deck</button>
							</div>

							@if ( EditorResult is not null )
							{
								<div class="deck-result">
									<div class="result-summary"><div>@EditorResult.Deck.Name</div><div>@EditorCardCount cards</div></div>
									@foreach ( DeckImportIssue issue in EditorResult.Issues )
									{
										<div class="issue">@issue.Message</div>
									}
									<div class="card-list">
										@foreach ( DeckEntry entry in EditorResult.Deck.Entries )
										{
											<div class="card-row"><div class="quantity">@entry.Quantity×</div><div class="card-name">@entry.Card.Name</div><div class="card-section">@entry.Section</div></div>
										}
									</div>
								</div>
							}
						</div>
					}
					else if ( CurrentPage == MenuPage.Settings )
					{
						<div class="settings-list">
							<TextEntry class="text-input" Value:bind="@LobbyName" Placeholder="Default match name" />
							<button class="setting-row" onclick="@ToggleMultiplayer"><div><div class="setting-name">Default match type</div><div class="setting-detail">Choose online play or local practice</div></div><div class="setting-value">@(Director?.IsMultiplayer == true ? "ONLINE" : "LOCAL")</div></button>
							<button class="setting-row" onclick="@ToggleProjection"><div><div class="setting-name">Camera projection</div><div class="setting-detail">Orthographic keeps card sizes consistent</div></div><div class="setting-value">@(TableCamera?.Orthographic == true ? "FLAT" : "PERSPECTIVE")</div></button>
							<div class="setting-row static"><div><div class="setting-name">Camera view height</div><div class="setting-detail">Controls how much of the table is visible</div></div><div class="stepper"><button onclick="@(() => ChangeViewHeight( -100f ))">remove</button><div>@CameraViewHeight</div><button onclick="@(() => ChangeViewHeight( 100f ))">add</button></div></div>
						</div>
					}

				}

				@if ( MenuMessage.Length > 0 )
				{
					<div class="menu-message">@MenuMessage</div>
				}
			</div>
		</div>
	}
	else if ( Match.State == MatchState.Lobby )
	{
		<div class="lobby-shell">
			<div class="lobby-header">
				<div><div class="eyebrow">MATCH LOBBY</div><div class="lobby-title">@(Director?.LobbyName ?? "Magic: The Gathering")</div><div class="page-copy">@Match.StatusText</div></div>
				<div class="player-count">@Match.Seats.Count / @(Director?.FormatFile?.MaximumPlayers ?? 0) players</div>
			</div>

			<div class="lobby-content">
				<div class="players-panel">
					<div class="section-title">Players</div>
					@foreach ( Seat seat in Match.Seats )
					{
						<div class="player-row @(seat.IsLocal ? "local" : string.Empty)"><div class="seat-number">@(seat.Index + 1)</div><div class="player-info"><div class="player-name">@seat.PlayerName @(seat.IsLocal ? "(You)" : string.Empty)</div><div class="muted">@(seat.HasSubmittedDeck ? $"{seat.DeckName} · {seat.DeckCardCount} cards" : "No deck submitted")</div></div><div class="ready-badge @(seat.Ready ? "ready" : string.Empty)">@(seat.Ready ? "Ready" : "Waiting")</div></div>
					}
				</div>

				<div class="submission-panel">
					<div class="section-title">Your Deck</div>
					<div class="page-copy">Paste a plain-text deck list, submit it, then ready up.</div>
					<TextEntry class="deck-input lobby-deck" Value:bind="@LobbyDeckText" Placeholder="4 Lightning Bolt&#10;4 Mountain&#10;…" Multiline="@true" />
					@foreach ( string issue in LobbyIssues )
					{
						<div class="issue">@issue</div>
					}
					@if ( LocalSeat?.DeckError is { Length: > 0 } deckError )
					{
						<div class="issue">@deckError</div>
					}
					<div class="lobby-actions"><button onclick="@SubmitLobbyDeck">@(LocalSeat?.HasSubmittedDeck == true ? "Replace Deck" : "Submit Deck")</button><button class="primary @(CanRequestReady ? string.Empty : "disabled")" onclick="@ToggleReady">@(LocalSeat?.Ready == true ? "Cancel Ready" : "Ready Up")</button></div>
				</div>
			</div>

			<div class="lobby-footer"><button class="leave-button" onclick="@LeaveMatch">Leave Match</button><div class="muted">The match begins when every player is ready.</div></div>
		</div>
	}
</root>

@code
{
	private enum MenuPage { Main, StartMatch, MatchList, DeckEditor, Settings }

	private MenuPage CurrentPage { get; set; }
	private string MenuMessage { get; set; } = string.Empty;
	private string LobbyDeckText { get; set; } = string.Empty;
	private List<string> LobbyIssues { get; set; } = [ ];
	private bool DeckSubmissionPending { get; set; }
	private string EditorDeckText { get; set; } = string.Empty;
	private DeckImportResult EditorResult { get; set; }
	private List<LobbyInformation> _lobbies = [ ];
	private bool _isRefreshing;
	private bool _isFinding;
	private int _queryGeneration;

	private GameDirector Director => Scene.Get<GameDirector>();
	private DatabaseManager Database => Scene.Get<DatabaseManager>();
	private Match Match => Director?.ActiveMatch;
	private Seat LocalSeat => Match?.Seats.FirstOrDefault( seat => seat.IsLocal );
	private TableCamera TableCamera => Scene.Camera?.GameObject.Components.Get<TableCamera>();
	private int EditorCardCount => EditorResult?.Deck.Entries.Sum( entry => entry.Quantity ) ?? 0;
	private int CameraViewHeight => (int)MathF.Round( TableCamera?.ViewHeight ?? 2000f );
	private bool CanStartMatch => Director?.FormatFile?.Prefab is not null;
	private string LobbyName
	{
		get { return Director?.LobbyName ?? string.Empty; }
		set { if ( Director is not null ) Director.LobbyName = value; }
	}
	private bool DatabaseCompatible => Database?.IsReady == true && Match is not null &&
		(string.IsNullOrWhiteSpace( Match.RequiredDatabaseChecksum )
			? Networking.IsHost
			: string.Equals( Database.DatabaseChecksum, Match.RequiredDatabaseChecksum, StringComparison.Ordinal ));
	private bool CanRequestReady => DatabaseCompatible &&
		(LocalSeat?.HasSubmittedDeck == true || DeckSubmissionPending && LocalSeat?.DeckError is not { Length: > 0 });
	private IReadOnlyList<MTGFormat> AvailableFormats
	{
		get
		{
			List<MTGFormat> formats = ResourceLibrary.GetAll<MTGFormat>().OrderBy( format => format.DisplayName ).ToList();
			if ( Director?.FormatFile is { } selected && !formats.Contains( selected )) formats.Add( selected );
			return formats;
		}
	}
	private string PageTitle => CurrentPage switch
	{
		MenuPage.StartMatch => "Start a Match",
		MenuPage.MatchList => "Current Matches",
		MenuPage.DeckEditor => "Deck Editor",
		MenuPage.Settings => "Game Settings",
		_ => "Main Menu"
	};
	private string PageDescription => CurrentPage switch
	{
		MenuPage.StartMatch => "Choose a format and create your table.",
		MenuPage.MatchList => "Select an open table to join.",
		MenuPage.DeckEditor => "Paste a deck list to validate and inspect it.",
		MenuPage.Settings => "Adjust defaults used by this game session.",
		_ => string.Empty
	};

	protected override void OnTreeFirstBuilt()
	{
		base.OnTreeFirstBuilt();
		Mouse.Visibility = MouseVisibility.Visible;
	}

	private void OpenPage( MenuPage page )
	{
		CurrentPage = page;
		MenuMessage = string.Empty;
		if ( page == MenuPage.MatchList ) RefreshMatches();
	}

	private void SelectFormat( MTGFormat format )
	{
		if ( Director is not null ) Director.FormatFile = format;
	}

	private bool IsSelected( MTGFormat format ) => format == Director?.FormatFile;
	private string FormatSummary( MTGFormat format ) => $"{format.MinimumPlayers}–{format.MaximumPlayers} players · {format.DeckSize}+ cards · {format.StartingLife} life";

	private void StartLobby()
	{
		if (!CanStartMatch || Director is null) { MenuMessage = "Select a format with a valid match prefab first."; return; }
		Director.LobbyName = string.IsNullOrWhiteSpace( LobbyName ) ? "Magic: The Gathering" : LobbyName.Trim();
		Director.StartLobby();
	}

	private async void RefreshMatches()
	{
		if ( _isRefreshing ) return;
		int generation = ++_queryGeneration;
		_isRefreshing = true;
		MenuMessage = string.Empty;
		StateHasChanged();
		try
		{
			List<LobbyInformation> found = await Networking.QueryLobbies( CancellationToken.None );
			if ( generation == _queryGeneration ) _lobbies = found.Where( lobby => !lobby.IsHidden ).OrderByDescending( lobby => lobby.Members ).ToList();
		}
		catch ( Exception exception )
		{
			if ( generation == _queryGeneration ) MenuMessage = $"Could not load matches: {exception.Message}";
		}
		finally
		{
			if ( generation == _queryGeneration ) { _isRefreshing = false; StateHasChanged(); }
		}
	}

	private async void QuickFindMatch()
	{
		if ( _isFinding ) return;
		_isFinding = true;
		MenuMessage = string.Empty;
		StateHasChanged();
		try
		{
			List<LobbyInformation> found = await Networking.QueryLobbies( CancellationToken.None );
			LobbyInformation lobby = found.FirstOrDefault( CanJoin );
			if ( lobby.LobbyId == 0 ) MenuMessage = "No open matches were found.";
			else JoinLobby( lobby );
		}
		catch ( Exception exception )
		{
			MenuMessage = $"Matchmaking failed: {exception.Message}";
		}
		finally
		{
			_isFinding = false;
			StateHasChanged();
		}
	}

	private static bool CanJoin( LobbyInformation lobby ) => !lobby.IsFull && !lobby.IsHidden && string.Equals( lobby.Get( "state", "joinable" ), "joinable", StringComparison.OrdinalIgnoreCase );
	private static string LobbyDetail( LobbyInformation lobby ) => $"{lobby.Members}/{lobby.MaxMembers} players" + (lobby.Ping >= 0 ? $" · {lobby.Ping} ms" : string.Empty);
	private void JoinLobby( LobbyInformation lobby )
	{
		if ( !CanJoin( lobby ) ) return;
		MenuMessage = $"Joining {lobby.Name}…";
		Networking.Connect( lobby.LobbyId );
	}

	private void ImportEditorDeck()
	{
		if ( string.IsNullOrWhiteSpace( EditorDeckText ) ) { MenuMessage = "Paste a deck list first."; return; }
		try { EditorResult = new PlainTextDeckParser().Import( EditorDeckText, new DeckImportOptions { DeckName = "Imported Deck" } ); MenuMessage = string.Empty; }
		catch ( Exception exception ) { EditorResult = null; MenuMessage = exception.Message; }
	}

	private void ClearEditor() { EditorDeckText = string.Empty; EditorResult = null; MenuMessage = string.Empty; }
	private void ToggleMultiplayer() { if ( Director is not null ) Director.IsMultiplayer = !Director.IsMultiplayer; }
	private void ToggleProjection() { if ( TableCamera is not null ) TableCamera.Orthographic = !TableCamera.Orthographic; }
	private void ChangeViewHeight( float amount ) { if ( TableCamera is not null ) TableCamera.ViewHeight = (TableCamera.ViewHeight + amount).Clamp( 600f, 4000f ); }
	private static void ExitGame() => Game.Close();

	private void SubmitLobbyDeck()
	{
		LobbyIssues = [ ];
		if ( !DatabaseCompatible ) { LobbyIssues.Add( Database?.FailureReason ?? Database?.StatusMessage ?? "Waiting for the card database to match the host." ); return; }
		if ( Match is null || string.IsNullOrWhiteSpace( LobbyDeckText ) ) { LobbyIssues.Add( "Paste a deck list before submitting." ); return; }
		try
		{
			DeckImportResult result = new PlainTextDeckParser().Import( LobbyDeckText, new DeckImportOptions { DeckName = "Imported Deck", FormatCode = Director?.FormatFile?.FormatCode } );
			LobbyIssues = result.Issues.Select( issue => issue.Message ).ToList();
			if ( result.HasErrors ) return;
			Match.SubmitDeck( DeckJson.Serialize( result.Deck ) );
			DeckSubmissionPending = true;
		}
		catch ( Exception exception ) { LobbyIssues.Add( exception.Message ); }
	}

	private void ToggleReady() { if ( Match is not null && DatabaseCompatible ) Match.SetReady( LocalSeat?.Ready != true ); }
	private void LeaveMatch() { Director?.LeaveGame(); CurrentPage = MenuPage.Main; }
	private string RootClass() => Match is { State: not MatchState.Lobby } ? "in-match" : string.Empty;

	protected override int BuildHash()
	{
		HashCode hash = new();
		hash.Add( CurrentPage ); hash.Add( MenuMessage ); hash.Add( LobbyDeckText ); hash.Add( EditorDeckText ); hash.Add( EditorResult );
		hash.Add( _isRefreshing ); hash.Add( _isFinding ); hash.Add( Director?.FormatFile ); hash.Add( Director?.LobbyName ); hash.Add( Director?.IsMultiplayer );
		hash.Add( Database?.State ); hash.Add( Database?.StatusMessage ); hash.Add( Match?.State ); hash.Add( Match?.LobbyRevision ); hash.Add( LocalSeat?.DeckError );
		hash.Add( TableCamera?.Orthographic ); hash.Add( TableCamera?.ViewHeight );
		foreach ( LobbyInformation lobby in _lobbies ) { hash.Add( lobby.LobbyId ); hash.Add( lobby.Name ); hash.Add( lobby.Members ); hash.Add( lobby.MaxMembers ); }
		foreach ( string issue in LobbyIssues ) hash.Add( issue );
		return hash.ToHashCode();
	}
}
